{
  "name": "aura-music-desktop",
  "version": "1.0.0",
  "description": "Aura Music Desktop - Cyberpunk Audio Player & Mobile Sync Hub",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb pacman",
    "dist:win": "electron-builder --windows nsis",
    "predist:win": "node scripts/fetch-ytdlp.js"
  },
  "keywords": [
    "music",
    "audio",
    "electron",
    "cyberpunk",
    "firebase",
    "sync",
    "android"
  ],
  "author": {
    "name": "David Tineo",
    "email": "respaldoperez348@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.4",
    "firebase-admin": "^13.1.0",
    "play-dl": "^1.9.7",
    "yt-search": "^2.12.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.auramusic.desktop",
    "productName": "Aura Music",
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "David Tineo <respaldoperez348@gmail.com>"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "yt-dlp.exe"
          ]
        }
      ]
    }
  }
}
